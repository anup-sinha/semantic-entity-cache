CACHE_SIMILARITY_THRESHOLD=0.80
CACHE_MISMATCH_PENALTY=0.45
CACHE_MAX_ENTRIES=1000
CACHE_NAMESPACE=default
CACHE_STORE_PROVIDER=memory

# Redis
REDIS_URL=redis://localhost:6379/0

# Azure AI Search
AZURE_AI_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX_NAME=semantic-cache

# Embedding provider
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Use 'heuristic' for default lightweight extraction or 'spacy' for stronger NER-based matching
ENTITY_EXTRACTION_PROVIDER=heuristic

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
